# Server Configuration
PORT=6544
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_ask_db
# Or use individual params:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=knowledge_ask_db
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Secret (use a strong random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# LLM Provider Configuration
# Options: mock (default, no API key needed), gemini, openai
LLM_PROVIDER=mock

# Gemini Configuration (when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI Configuration (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-openai-api-key-here

# Embedding Configuration
EMBEDDING_PROVIDER=mock
# OPENAI_API_KEY=your-key (if using openai embeddings)
# GEMINI_API_KEY=your-key (if using gemini embeddings)

# File Upload Settings
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# RAG Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_CHUNKS=5
