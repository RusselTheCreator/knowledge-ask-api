# =============================================================================
# Knowledge Ask API - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=6544
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (recommended)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_ask_db

# Or use individual parameters (alternative to DATABASE_URL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=knowledge_ask_db
# DB_USER=postgres
# DB_PASSWORD=postgres

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Use a strong random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-this-in-production

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS
# For local development with Vite: http://localhost:5173
# For staging frontend: https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Time window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window for general endpoints
RATE_LIMIT_MAX_REQUESTS=100

# Specific limits for sensitive endpoints
RATE_LIMIT_AUTH_MAX=10      # Authentication (register/login)
RATE_LIMIT_UPLOAD_MAX=20    # File uploads
RATE_LIMIT_ASK_MAX=50       # Q&A requests

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Options: mock (default), openai
# 
# 'mock' - No API key needed, deterministic answers for dev/testing/CI
# 'openai' - Uses OpenAI API (recommended for staging/production)
LLM_PROVIDER=mock

# -----------------------------------------------------------------------------
# Embedding Provider Configuration
# -----------------------------------------------------------------------------
# Options: mock (default), openai
# 
# IMPORTANT: Set BOTH LLM_PROVIDER and EMBEDDING_PROVIDER when using OpenAI
EMBEDDING_PROVIDER=mock

# -----------------------------------------------------------------------------
# OpenAI Configuration (when using openai provider)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# IMPORTANT: Set usage limits in OpenAI dashboard before deploying!
# 
# OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override default models (defaults are cost-effective for Free tier)
# OPENAI_CHAT_MODEL=gpt-4o-mini              # Default chat model
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Default embedding model

# -----------------------------------------------------------------------------
# Gemini Configuration (optional, not recommended for this deployment)
# -----------------------------------------------------------------------------
# Uncomment to use Google Gemini instead of OpenAI
# Get your API key from: https://makersuite.google.com/app/apikey
# 
# LLM_PROVIDER=gemini
# EMBEDDING_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key-here

# -----------------------------------------------------------------------------
# File Upload Settings
# -----------------------------------------------------------------------------
# Maximum file size in megabytes
MAX_FILE_SIZE_MB=10

# Directory for storing uploaded files
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation) Settings
# -----------------------------------------------------------------------------
# Size of each text chunk in characters
CHUNK_SIZE=600

# Overlap between consecutive chunks in characters
CHUNK_OVERLAP=100

# Number of most relevant chunks to retrieve for answering
TOP_K_CHUNKS=5

# -----------------------------------------------------------------------------
# Security & Development Settings
# -----------------------------------------------------------------------------
# Enable default admin account (admin@example.com / admin123)
# ⚠️  NEVER enable in production! Only for local development/testing.
# ENABLE_DEFAULT_ADMIN=true

# =============================================================================
# DEPLOYMENT CHECKLIST (Render / Production)
# =============================================================================
#
# Required environment variables for staging/production:
# 
# 1. SERVER & DATABASE:
#    - NODE_ENV=production
#    - DATABASE_URL=<your-postgres-connection-string>
#    - JWT_SECRET=<strong-random-secret>
#    - PORT=<auto-set-by-render>
#
# 2. LLM CONFIGURATION (choose one):
#    Option A - OpenAI (recommended):
#      - LLM_PROVIDER=openai
#      - EMBEDDING_PROVIDER=openai
#      - OPENAI_API_KEY=<your-openai-key>
#    
#    Option B - Mock (testing only):
#      - LLM_PROVIDER=mock
#      - EMBEDDING_PROVIDER=mock
#
# 3. CORS:
#    - CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
#
# 4. OPTIONAL OVERRIDES:
#    - MAX_FILE_SIZE_MB (default: 10)
#    - Rate limiting values (use defaults if unsure)
#    - OpenAI model overrides (use defaults for Free tier)
#
# 5. SECURITY:
#    - DO NOT set ENABLE_DEFAULT_ADMIN=true
#    - Create admin users manually with strong passwords
#    - Set OpenAI usage limits in dashboard before deploying
#
# =============================================================================
