{
  "name": "knowledge-ask-api",
  "version": "1.0.0",
  "description": "RAG-powered knowledge API with document upload and Q&A",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=/test/e2e/ --testPathIgnorePatterns=/test/integration/ --testPathIgnorePatterns=/test/api/ --testPathIgnorePatterns=/test/live/",
    "test:e2e": "playwright test",
    "test:live": "NODE_OPTIONS=--experimental-vm-modules jest test/live/",
    "test:all": "npm test && npm run test:e2e",
    "pre-deploy": "bash scripts/pre-deploy-check.sh",
    "deploy": "npm run pre-deploy && git push origin main"
  },
  "keywords": [
    "express",
    "postgresql",
    "rag",
    "llm",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1141.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.49.1",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "supertest": "^7.0.0"
  }
}
